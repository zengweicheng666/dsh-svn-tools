{
  "name": "dsh-svn-tools",
  "description": "SVN (Subversion) tools + sidebar UI for DeepSeek Harness: 33 svn_* agent tools with full command coverage (status/info/diff/log/blame/list/cat/add/delete/mkdir/copy/move/merge/switch/checkout/cleanup/resolve/props/commit...) and UTF-8 Chinese commit logs, plus an SVN panel that renders in DSH's built-in right Sidebar (0.1.0-rc.6+) or dsh-better-sidebar — carrier and 9 more options are configurable in Settings; works on DSH 0.1.x and 0.2.x.",
  "version": "0.16.0",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zengweicheng666/dsh-svn-tools.git"
  },
  "homepage": "https://github.com/zengweicheng666/dsh-svn-tools#readme",
  "bugs": {
    "url": "https://github.com/zengweicheng666/dsh-svn-tools/issues"
  },
  "scripts": {
    "verify:hardening": "node scripts/verify-hardening.mjs",
    "verify:offline": "node scripts/verify-offline-modes.mjs",
    "verify:offline:host": "node scripts/verify-offline-host.mjs",
    "verify:readme": "node scripts/verify-readme.mjs",
    "verify:settings": "node scripts/verify-settings.mjs",
    "verify:settings:host": "node scripts/verify-settings-host.mjs",
    "verify:theme": "node scripts/verify-theme.mjs",
    "verify:tools": "node scripts/verify-tool-output.mjs",
    "verify:multi-wc": "node scripts/verify-multi-wc.mjs",
    "verify:list-dir": "node scripts/verify-list-dir.mjs",
    "verify:dir-browser": "node scripts/verify-dir-browser.mjs"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "svn",
    "subversion",
    "version-control",
    "sidebar",
    "settings"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-modules"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.2",
    "dsh-better-sidebar": ">=0.18.0"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts/verify-hardening.mjs",
    "scripts/verify-offline-modes.mjs",
    "scripts/verify-offline-host.mjs",
    "scripts/verify-readme.mjs",
    "scripts/verify-settings.mjs",
    "scripts/verify-settings-host.mjs",
    "scripts/verify-theme.mjs",
    "scripts/verify-tool-output.mjs",
    "scripts/verify-multi-wc.mjs",
    "scripts/verify-list-dir.mjs",
    "scripts/verify-dir-browser.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ]
}
